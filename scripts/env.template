# TUTOR OS 환경변수 템플릿 — .env.local로 복사해 채운다 (전부 서버 전용, 클라이언트 노출 금지)
# cp scripts/env.template .env.local

# ── Supabase (필수) ───────────────────────────────────────────
# 대시보드 → Settings → API
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# 셋업 스크립트 전용 (Settings → Database → Connection string, 세션 모드 5432)
SUPABASE_DB_URL=

# ── 관리자 인증 ────────────────────────────────────────────────
# openssl rand -base64 32
AUTH_SECRET=
# true면 OTP를 메일 대신 화면에 표시 (로컬 개발 전용 — 프로덕션 금지)
AUTH_DEV_MODE=false

# ── 트랜잭션 메일 (OTP 발송 — Resend) ─────────────────────────
RESEND_API_KEY=
MAIL_FROM=login@axiommathlab.kr

# ── Solapi (알림톡→SMS 폴백) ──────────────────────────────────
SOLAPI_API_KEY=
SOLAPI_API_SECRET=
SOLAPI_SENDER_PHONE=
# 카카오 비즈채널 연결 후 입력 — 비우면 SMS 모드(계약: SMS 선인수 가능)
SOLAPI_KAKAO_CHANNEL_ID=
# 알림톡 타입별 템플릿 ID 매핑(JSON) — 예: {"payment_d3":"KA01TP...","lesson_reminder":"KA01TP..."}
# 템플릿 심사 승인 후 입력. 미설정 타입은 자동 SMS 폴백
SOLAPI_TEMPLATE_IDS=

# ── 토스페이먼츠 (일회성 결제 링크 + 웹훅) ────────────────────
# 가맹 승인 후 발급 — 시크릿 키만 사용 (클라이언트 키 불필요)
TOSS_SECRET_KEY=

# ── 결제선생 (Payssam 파트너 API V2 — 청구서 발송·수납) ───────
# 샌드박스/운영 키가 다르다: 개발은 샌드박스 키, 검수(검수 5종 BILL-ID 제출) 통과 후
# 운영 API Key·운영 URL을 별도 수령해 교체한다. 절차: docs/payssam-integration.md
PAYSSAM_API_KEY=
PAYSSAM_MEMBER_ID=
PAYSSAM_MERCHANT_ID=
# 샌드박스: https://sandbox.paymint.co.kr/partner / 운영: 검수 완료 후 별도 제공(기본값 없음 —
# 4개 전부 있어야 연동 게이트가 열린다. 샌드박스/운영이 뒤바뀌는 사고 방지)
PAYSSAM_BASE_URL=
# 승인 콜백 수신 URL(옵션) — 비우면 NEXT_PUBLIC_SITE_URL + /api/payssam/callback
# 결제선생 서버가 호출하므로 공개 URL이어야 한다(localhost 불가)
PAYSSAM_CALLBACK_URL=

# ── AI 리포트 (4단 모델 — 모델 교체는 여기서만, 코드 수정 불필요) ──
ANTHROPIC_API_KEY=
REPORT_AI_LESSON=claude-haiku-4-5
REPORT_AI_WEEKLY=claude-sonnet-5
REPORT_AI_MONTHLY=claude-sonnet-5
REPORT_AI_MONTHLY_DEEP=claude-fable-5
REPORT_AI_EXAM=claude-fable-5
REPORT_AI_CONSULT=claude-fable-5
AI_FALLBACK_MODEL=claude-haiku-4-5

# ── 자동화 크론 (엣지 함수 → Next API 보호 토큰) ──────────────
# openssl rand -hex 24
CRON_SECRET=
